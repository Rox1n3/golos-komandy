# Ключ OpenAI — необязательно. Без него портал полностью работает: подсказки делаются по простым правилам,
# а ИИ-ассистент руководства, голосовой ввод и кнопка «Перевести» недоступны.
# Скопируйте этот файл в .env.local и укажите ключ.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MODEL_SMART=gpt-5.5
OPENAI_MODEL_STT=gpt-4o-transcribe
# Сколько миллисекунд ждать ответа ИИ, прежде чем перейти на офлайн-логику (по умолчанию 15000).
# OPENAI_TIMEOUT_MS=15000
